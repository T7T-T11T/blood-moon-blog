# ============================================
# 个人博客系统 - 后端环境变量配置（示例）
# 复制此文件为 .env 并填入实际值
# ============================================

# MySQL 数据库连接配置
DB_HOST=localhost                    # 数据库地址（生产环境改为实际地址）
DB_PORT=3306                         # 数据库端口
DB_USER=root                         # 数据库用户名（生产环境建议创建专用用户，非root）
DB_PASSWORD=your_mysql_password      # 数据库密码
DB_NAME=task_manager                 # 数据库名

# JWT 配置
JWT_SECRET=your_random_secret_key_at_least_32_chars  # JWT 签名密钥（生产环境必须使用随机强密钥，至少32字符）
JWT_EXPIRES_IN=7d                    # Token 有效期

# 服务器配置
SERVER_PORT=3000                     # 后端服务端口

# CORS 跨域配置（生产环境必填）
# 逗号分隔的域名白名单，如：https://blog.example.com,https://www.blog.example.com
# 不配置时默认允许 localhost:5173 和 localhost:4173
CORS_ORIGIN=https://your-domain.com
