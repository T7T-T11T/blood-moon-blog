# ============================================
# 个人效率中心 - 后端环境变量配置（示例）
# 复制此文件为 .env 并填入实际值
# ============================================

# MySQL 数据库连接配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task_manager

# JWT 配置
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# 服务器配置
SERVER_PORT=3000
