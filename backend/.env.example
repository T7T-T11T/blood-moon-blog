# ============================================
# 个人博客系统 - 后端环境变量配置（示例）
# 复制此文件为 .env 并填入实际值
# 数据库：PostgreSQL (Supabase)
# ============================================

# 方式一：独立参数（本地 PostgreSQL）
DB_HOST=localhost                    # 数据库地址
DB_PORT=5432                         # PostgreSQL 端口
DB_USER=postgres                     # 数据库用户名
DB_PASSWORD=your_pg_password         # 数据库密码
DB_NAME=blood_moon_blog              # 数据库名

# 方式二：Supabase 连接串（生产环境推荐）
# SUPABASE_URL=postgresql://postgres:xxxx@db.xxx.supabase.com:5432/postgres

# JWT 配置
JWT_SECRET=your_random_secret_key_at_least_32_chars  # JWT 签名密钥（至少32字符）
JWT_EXPIRES_IN=7d                    # Token 有效期

# 服务器配置
SERVER_PORT=3000                     # 后端服务端口
NODE_ENV=production                  # 环境：development / production

# CORS 跨域配置
CORS_ORIGIN=https://your-domain.com  # 允许的域名（逗号分隔）
