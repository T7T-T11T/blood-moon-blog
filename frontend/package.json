    "element-plus": "^2.5.0",
    "gsap": "^3.15.0",
    "marked": "^15.0.0",
    "pinia": "^2.1.0",
    "turndown": "^7.2.4",
    "vditor": "^3.11.3",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.24.0",
    "prettier": "^3.2.5",
    "sharp": "^0.35.3",
