# Cloudflare Pages 缓存配置
# 文档参考：https://developers.cloudflare.com/pages/platform/headers/

# index.html - 禁止缓存，确保每次加载最新版本
# 因为 index.html 引用了带 hash 的 JS/CSS 文件
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# 带 hash 的静态资源 - 长期缓存（文件名含 hash，内容变则 hash 变）
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# 图片资源 - 中等缓存
/*.{png,jpg,jpeg,gif,webp,svg,ico}
  Cache-Control: public, max-age=86400

# 字体资源 - 长期缓存
/*.{woff,woff2,ttf,eot,otf}
  Cache-Control: public, max-age=31536000

# JS/CSS 文件 - 长期缓存（带 hash）
/*.{js,css}
  Cache-Control: public, max-age=31536000

# API 请求 - 禁止缓存
/api/*
  Cache-Control: no-store
