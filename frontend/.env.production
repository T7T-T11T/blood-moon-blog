# ============================================
# 生产环境配置 - Cloudflare Pages 部署
# ============================================
# 
# 架构说明：
#   前端（Cloudflare Pages）→ 直接请求 Cloudflare Workers 后端（跨域）
#   Workers 后端已配置 CORS，允许跨域访问
#
# 注意：Cloudflare Pages Functions 不支持 fetch 子请求，
#       因此不能用 Functions 做代理，改为前端直接请求 Workers
# ============================================

# API 基础路径：直接请求 Cloudflare Workers 后端（跨域）
VITE_API_BASE_URL=https://blood-moon-blog-api.2198789717.workers.dev/api

# 站点配置
VITE_SITE_NAME=寿冬与秋
VITE_SITE_DESCRIPTION=暗夜之下 笔墨不灭
